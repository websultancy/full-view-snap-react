# LambdaTest credentials — https://accounts.lambdatest.com/security
LT_USERNAME=
LT_ACCESS_KEY=

# Required: URL under test (e.g. published demo or LambdaTest tunnel target)
LT_DEMO_URL=

# Optional: LambdaTest tunnel name from the CLI (enables tunnel for all sessions)
# LT_TUNNEL_NAME=your-tunnel-uuid

# Dashboard grouping
LT_BUILD=full-view-snap-react

# Parallel sessions allowed by your LambdaTest plan.
# Cheapest / freemium tiers: use 1 so tests run one-at-a-time and do not queue or fail.
LT_MAX_PARALLEL=1

# Free Automation tier: leave false (desktop virtual browsers only).
# Real-device mobile profiles need Real Device Plus; set true only if subscribed.
# LT_INCLUDE_MOBILE=false

# Optional: run a subset (comma-separated ids from config/browsers.js)
# LT_BROWSERS=chrome-desktop,firefox-desktop
